          "expr": "topk(10, sum by (route) (rate(odoo_http_sql_queries_total{db=~\"$db\"}[$__rate_interval])) / sum by (route) (rate(odoo_http_request_duration_seconds_count{db=~\"$db\"}[$__rate_interval])))",
