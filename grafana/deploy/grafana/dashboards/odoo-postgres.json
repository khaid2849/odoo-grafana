            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=~\"$datname\"}[$__rate_interval])) / clamp_min(sum(rate(pg_stat_database_blks_hit{datname=~\"$datname\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{datname=~\"$datname\"}[$__rate_interval])), 1e-9)",
