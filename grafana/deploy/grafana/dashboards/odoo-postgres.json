    {
      "type": "table",
      "title": "Top queries by total time (pg_stat_statements)",
      "description": "Cumulative since the last pg_stat_statements_reset().",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "odoo-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "odoo-postgres"
          },
          "rawSql": "SELECT calls AS \"Calls\",\n               round(total_exec_time::numeric) AS \"Total (ms)\",\n               round(mean_exec_time::numeric, 2) AS \"Mean (ms)\",\n               rows AS \"Rows\",\n               round((100.0 * shared_blks_hit / nullif(shared_blks_hit + shared_blks_read, 0))::numeric, 1) AS \"Hit %\",\n               left(query, 400) AS \"Query\"\n        FROM pg_stat_statements s\n        JOIN pg_database d ON d.oid = s.dbid\n        WHERE d.datname = current_database()\n        ORDER BY total_exec_time DESC\n        LIMIT 25",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 12
      }
