    {
      "type": "table",
      "title": "Unused indexes",
      "description": "Never used since the last stats reset; they cost write time and disk.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "odoo-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "odoo-postgres"
          },
          "rawSql": "SELECT s.relname AS \"Table\",\n               s.indexrelname AS \"Index\",\n               pg_relation_size(s.indexrelid) AS \"Size\"\n        FROM pg_stat_user_indexes s\n        JOIN pg_index i ON i.indexrelid = s.indexrelid\n        WHERE s.idx_scan = 0 AND NOT i.indisunique AND NOT i.indisprimary\n        ORDER BY pg_relation_size(s.indexrelid) DESC\n        LIMIT 15",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
