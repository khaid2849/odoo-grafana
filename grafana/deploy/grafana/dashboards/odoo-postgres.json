    {
      "type": "table",
      "title": "Sequential scans on large tables (index candidates)",
      "description": "Large tables read mostly by sequential scans often miss an index on a field used in domains (add index=True on the Odoo field).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "odoo-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "odoo-postgres"
          },
          "rawSql": "SELECT relname AS \"Table\",\n               seq_scan AS \"Seq scans\",\n               seq_tup_read AS \"Rows read by seq scans\",\n               idx_scan AS \"Index scans\",\n               n_live_tup AS \"Rows\"\n        FROM pg_stat_user_tables\n        WHERE n_live_tup > 10000\n        ORDER BY seq_tup_read DESC\n        LIMIT 15",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
