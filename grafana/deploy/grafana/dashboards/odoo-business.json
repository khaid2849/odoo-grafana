    {
      "type": "table",
      "title": "Costliest slow queries (by fingerprint)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "odoo-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "odoo-postgres"
          },
          "rawSql": "SELECT query_hash AS \"Fingerprint\",\n               count(*) AS \"Count\",\n               round(sum(duration_ms)::numeric) AS \"Total (ms)\",\n               round(avg(duration_ms)::numeric) AS \"Avg (ms)\",\n               left(min(query), 300) AS \"Query\"\n        FROM grafana_slow_query\n        WHERE $__timeFilter(request_date)\n        GROUP BY query_hash\n        ORDER BY sum(duration_ms) DESC\n        LIMIT 25",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
