    {
      "type": "table",
      "title": "Scheduled actions health",
      "description": "Overdue = the action should have run more than 10 minutes ago (cron workers busy, stuck or not running).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "odoo-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "odoo-postgres"
          },
          "rawSql": "SELECT cron_name AS \"Action\",\n               active AS \"Active\",\n               nextcall AS \"Next call (UTC)\",\n               lastcall AS \"Last call (UTC)\",\n               failure_count AS \"Failures\",\n               CASE WHEN active AND nextcall < (now() AT TIME ZONE 'UTC') - interval '10 minutes'\n                    THEN extract(epoch FROM (now() AT TIME ZONE 'UTC') - nextcall) END AS \"Overdue\"\n        FROM ir_cron\n        ORDER BY failure_count DESC, active DESC, nextcall",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Overdue"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "id": 10,
