          "rawSql": "SELECT relname AS \"Table\",\n               n_live_tup AS \"Rows\",\n               pg_total_relation_size(relid) AS \"Total size\",\n               pg_indexes_size(relid) AS \"Index size\"\n        FROM pg_stat_user_tables\n        ORDER BY pg_total_relation_size(relid) DESC\n        LIMIT 20",
          "format": "table",
