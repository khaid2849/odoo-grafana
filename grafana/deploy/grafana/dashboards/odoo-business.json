    {
      "type": "timeseries",
      "title": "Slow request duration split",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "odoo-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "odoo-postgres"
