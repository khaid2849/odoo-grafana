    {
      "type": "table",
      "title": "Slowest endpoints",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "odoo-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "odoo-postgres"
          },
          "rawSql": "SELECT coalesce(rpc_model || '.' || rpc_method, route) AS \"Endpoint\",\n               count(*) AS \"Hits\",\n               round(avg(duration_ms)::numeric) AS \"Avg (ms)\",\n               round(max(duration_ms)::numeric) AS \"Max (ms)\",\n               round(avg(query_count)::numeric) AS \"Avg queries\",\n               round((sum(query_time_ms) / nullif(sum(duration_ms), 0) * 100)::numeric) AS \"SQL %\"\n        FROM grafana_slow_request\n        WHERE $__timeFilter(request_date)\n        GROUP BY 1\n        ORDER BY sum(duration_ms) DESC\n        LIMIT 25",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 10
