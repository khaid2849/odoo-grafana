          "rawSql": "SELECT $__timeGroupAlias(request_date, '1h'), sum(query_time_ms) / 1000 AS \"SQL\", sum(python_time_ms) / 1000 AS \"Python\" FROM grafana_slow_request WHERE $__timeFilter(request_date) GROUP BY 1 ORDER BY 1",
