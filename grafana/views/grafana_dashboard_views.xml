<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="grafana_dashboard_view_list" model="ir.ui.view">
        <field name="name">grafana.dashboard.list</field>
        <field name="model">grafana.dashboard</field>
        <field name="arch" type="xml">
            <list string="Dashboards">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="uid"/>
                <field name="time_from"/>
                <field name="refresh"/>
                <field name="kiosk"/>
            </list>
        </field>
    </record>

    <record id="grafana_dashboard_view_form" model="ir.ui.view">
        <field name="name">grafana.dashboard.form</field>
        <field name="model">grafana.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Sales KPIs"/></h1>
                    </div>
                    <group>
                        <group string="Grafana">
                            <field name="uid"/>
                            <field name="kiosk"/>
                        </group>
                        <group string="Display">
                            <field name="time_from"/>
                            <field name="refresh"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What this dashboard shows..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="grafana_dashboard_action" model="ir.actions.act_window">
        <field name="name">Dashboards</field>
        <field name="res_model">grafana.dashboard</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="grafana_embed_action" model="ir.actions.client">
        <field name="name">Grafana</field>
        <field name="tag">grafana.embed</field>
    </record>
</odoo>
